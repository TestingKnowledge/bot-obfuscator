# Discord bot token
DISCORD_TOKEN=

# GitHub fine-grained token with Contents: Read and write access
GITHUB_TOKEN=

# Public repository in owner/repository format
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_DIR=obfuscated

# Bot settings
BOT_PREFIX=.
DEFAULT_PRESET=Medium
MAX_FILE_MB=5
OBFUSCATE_TIMEOUT=120

# Render supplies PORT automatically. Leave this unset on Render.
PORT=10000
