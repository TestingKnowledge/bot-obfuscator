-- 3. Reusable Server Hop Function (Targets 20-22 players)
local function serverHop()
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")
    local placeId = game.PlaceId
    local currentJob = game.JobId
    
    pcall(function()
        local raw = game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100")
        local body = HttpService:JSONDecode(raw)
        
        if body and body.data then
            for _, server in ipairs(body.data) do
                if server.id ~= currentJob and server.playing >= 20 and server.playing <= 22 then
                    print("Found server with " .. server.playing .. " players. Teleporting...")
                    TeleportService:TeleportToPlaceInstance(placeId, server.id, lp)
                    return
                end
            end
        end
    end)
end

-- 4. Auto Server Hop (Smart Logic to prevent both accounts hopping)
local function checkUser(player)
    if not getgenv().AvoidUsers then return end
    
    for _, user in pairs(getgenv().AvoidUsers) do
        if player.Name == user or player.UserId == user then
            -- Compare UserIDs to decide who leaves. The HIGHER ID leaves, LOWER ID stays.
            if lp.UserId > player.UserId then
                print("Listed user detected: " .. player.Name .. ". My ID is higher, so I am hopping...")
                serverHop()
            else
                print("Listed user detected: " .. player.Name .. ". My ID is lower, so I am staying. They will hop.")
            end
            return
        end
    end
end

-- Check players who are ALREADY in the server when you execute
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= lp then
        checkUser(player)
    end
end

-- Check players who JOIN the server AFTER you execute
Players.PlayerAdded:Connect(checkUser)

-- 5. Server Hop Timer (after 10 minutes / 600 seconds)
task.delay(600, function()
    print("10 minutes reached. Initiating timer hop...")
    serverHop()
end)

-- 6. Execution Function (2s delay -> Reset -> Loadstring)
local function runScript()
    task.wait(1)
    
    local char = lp.Character
    if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
        char.Humanoid.Health = 0
        lp.CharacterAdded:Wait() -- Wait for fresh character spawn after reset
    end
    
    -- New loadstring applied here
    loadstring(game:HttpGet("https://raw.githubusercontent.com/TestingKnowledge/bot-obfuscator/main/obfuscated/break-6232f8825c.lua"))()
end

